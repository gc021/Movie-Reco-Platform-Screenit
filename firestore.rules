rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Platform metrics & aggregated counters
    match /analytics_metrics/{metricId} {
      allow read: if true;
      allow write: if true;
    }

    // Individual captured user leads
    match /leads/{leadId} {
      allow read: if true;
      allow write: if true;
    }

    // Telemetry events (page views, starts, completions)
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
